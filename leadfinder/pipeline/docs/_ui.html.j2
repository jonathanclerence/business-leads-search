{# Building blocks shared by every page. Loaded once as a module and passed
   to the pages as `ui`. Icons are Lucide (ISC licence), stroked at 1.8. #}

{% macro mark(size="7mm", tone="tile", cls="") -%}
<svg class="mark {{ cls }}" style="width:{{ size }};height:{{ size }}" viewBox="0 0 100 100" aria-hidden="true">
  {%- if tone == "tile" %}<rect width="100" height="100" rx="22" fill="url(#dn-tile)"/>{% endif %}
  <g transform="translate(29 22.5) scale(0.168)" fill="{{ '#082f49' if tone == 'navy' else '#f4f6f8' }}">
    <path d="M0 0L64 72V255L16 327H0Z"/>
    <path d="M16 0H114A163.5 163.5 0 0 1 114 327H32L80 255H130A91.5 91.5 0 0 0 130 72H80Z"/>
  </g>
</svg>
{%- endmacro %}

