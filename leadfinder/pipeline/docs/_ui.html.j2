{% macro icon(name) -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ ICONS[name] | safe }}</svg>
{%- endmacro %}

{% macro ticks(items) -%}
<ul class="ticks">{% for item in items %}<li><span class="tick">{{ icon("check") }}</span><span>{{ item }}</span></li>{% endfor %}</ul>
{%- endmacro %}

{# A box the client types into: drawn here, made a real PDF field afterwards. #}
{% macro field(name, label, value="", hint="", h="8mm", multi=false, cls="") -%}
<div class="field {{ cls }}">
  <span class="field-label">{{ label }}{% if hint %} <i>{{ hint }}</i>{% endif %}</span>
  <span class="field-box" style="height:{{ h }}" data-field="{{ name }}" data-kind="{{ 'multi' if multi else 'text' }}" data-label="{{ label }}" data-value="{{ value or '' }}"></span>
</div>
{%- endmacro %}

{% macro check(name, label, sub="", cls="") -%}
<div class="choice {{ cls }}"><span class="check-box" data-field="{{ name }}" data-kind="check" data-label="{{ label }}"></span><span><b>{{ label }}</b>{% if sub %}<small>{{ sub }}</small>{% endif %}</span></div>
{%- endmacro %}
