# Copy this file to `.env` and fill in what you need.
# Everything here is OPTIONAL — the Playwright scraper works with no config at all.

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000

# ----------------------------------------------------------------------------
# Scraper tuning
# ----------------------------------------------------------------------------
# Show the browser window while scraping (great for debugging). true|false
HEADLESS=true
# How many place detail pages to open at once. 2-6 is sane. Higher = faster
# but more likely to get rate-limited by Google.
SCRAPER_CONCURRENCY=4
# Per-page navigation timeout, milliseconds.
SCRAPER_TIMEOUT_MS=30000
# Language + region for Google Maps. GL must be the country you're searching,
# or ambiguous town names resolve abroad (Portland → Oregon).
SCRAPER_HL=en
SCRAPER_GL=au
# Browser locale + timezone (also steer Google's idea of "where").
# SCRAPER_LOCALE=en-AU
# SCRAPER_TIMEZONE=Australia/Melbourne
# Default state/country appended to every batch search; results outside the
# country are dropped. Per batch: `batch_cli.py run --state NSW`.
# SCRAPER_STATE=VIC
# SCRAPER_COUNTRY=Australia
# Optional upstream proxy, e.g. http://user:pass@host:port
# SCRAPER_PROXY=
# Use a Chrome/Chromium you already have instead of Playwright's download.
# macOS example:
# PLAYWRIGHT_CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ----------------------------------------------------------------------------
# Google Places API (New) — optional alternative engine
# Enable "Places API (New)" in Google Cloud Console, then paste the key here.
# ----------------------------------------------------------------------------
# GOOGLE_MAPS_API_KEY=AIza...

# ----------------------------------------------------------------------------
# Google Sheets export — optional
# Path to a service-account JSON key with the Sheets + Drive APIs enabled.
# ----------------------------------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
# Share the target spreadsheet with the service account's client_email,
# or leave blank and the app will create a new sheet and share it with you.
# GSHEET_SHARE_WITH=you@example.com

# ----------------------------------------------------------------------------
# Sales pipeline (python -m pipeline …, tracker at /pipeline) — all optional
# ----------------------------------------------------------------------------
# The dunous.com repo (default: ../../marketing-site next to this project)
# MARKETING_SITE_DIR=~/Documents/Dunous/marketing-site
# The branch Cloudflare Pages deploys to production; publish pushes previews here
# PUBLISH_BRANCH=main
# Scratch checkout used only for publishing (your own checkout is never touched)
# PUBLISH_WORKTREE=~/Documents/Dunous/.marketing-site-publish
# PREVIEW_SITE_URL=https://www.dunous.com
# PREVIEW_WHATSAPP_DISPLAY=(+61) 422 765 361
# PREVIEW_WHATSAPP_HREF=https://wa.me/61422765361
# Adds a "Buy it now" button to every preview, linking to the site's checkout.
# Turn on only after the marketing site's /buy page is live on PUBLISH_BRANCH.
# PREVIEW_CHECKOUT_PATH=/buy
# Pre-fills the DuNous side of the service agreement's signature block.
# DOCS_SIGNATORY=Your Name
